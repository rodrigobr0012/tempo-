// Tokens de cor e espaçamento. Segue o tema claro/escuro do sistema (RF35).
// Contrastes de texto ≥ 4,5:1 sobre `surface` e `bg` (RNF21).
import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    out property <color> bg: dark ? #111113 : #F4F4F7;
    out property <color> surface: dark ? #1C1C20 : #FFFFFF;
    out property <color> surface-2: dark ? #2A2A30 : #ECECF1;
    out property <color> line: dark ? #32323A : #E0E0E7;
    out property <color> text: dark ? #F2F2F5 : #17171A;
    out property <color> text-2: dark ? #B0B0BA : #55555F;
    out property <color> accent: dark ? #8AB4FF : #2853C8;
    out property <color> on-accent: dark ? #0B1530 : #FFFFFF;
    out property <color> accent-soft: dark ? #1E2B4A : #E3EAFC;
    out property <color> danger: dark ? #FF8A80 : #B3261E;
    out property <color> success: dark ? #6EE7B7 : #047857;
    out property <color> warn-bg: dark ? #3A2E12 : #FFF3D1;
    out property <color> warn-text: dark ? #FFD27A : #6B4700;
    out property <color> scrim: #00000099;

    out property <length> radius: 16px;
    out property <length> pad: 16px;
    out property <length> gap: 12px;
    out property <length> touch: 48px;
}

