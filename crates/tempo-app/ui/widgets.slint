// Componentes visuais reutilizáveis. Alvos de toque têm no mínimo 48px.
import { Theme, Icons } from "theme.slint";
import { Segment } from "types.slint";

export component Icon inherits Path {
    in property <color> tint: Theme.text;
    width: 24px;
    height: 24px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: tint;
    stroke-width: 0px;
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> tint: Theme.text;
    in property <color> fill: transparent;
    in property <bool> enabled: true;
    callback clicked();

    width: Theme.touch;
    height: Theme.touch;
    border-radius: self.height / 2;
    background: ta.pressed ? Theme.surface-2 : root.fill;
    opacity: root.enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.label;

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: root.icon;
        tint: root.tint;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// kind: 0 principal · 1 tonal · 2 texto · 3 perigo
export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <int> kind: 0;
    in property <bool> enabled: true;
    callback clicked();

    property <color> fg: kind == 0 ? Theme.on-accent : kind == 3 ? #FFFFFF : kind == 2 ? Theme.accent : Theme.text;

    min-height: Theme.touch;
    border-radius: self.height / 2;
    background: kind == 0 ? Theme.accent : kind == 1 ? Theme.surface-2 : kind == 3 ? Theme.danger : transparent;
    opacity: !root.enabled ? 0.4 : ta.pressed ? 0.8 : 1;
    accessible-role: button;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                commands: root.icon;
                tint: root.fg;
            }
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

export component Card inherits Rectangle {
    in property <length> inner-padding: Theme.pad;
    in property <length> inner-spacing: 10px;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: root.inner-padding;
        spacing: root.inner-spacing;
        @children
    }
}

export component Bar inherits Rectangle {
    in property <float> progress;
    in property <color> tint: Theme.accent;
    height: 6px;
    border-radius: self.height / 2;
    background: Theme.surface-2;
    clip: true;
    accessible-role: progress-indicator;
    accessible-value: Math.round(clamp(root.progress, 0, 1) * 100) + "%";
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        height: parent.height;
        border-radius: parent.height / 2;
        background: root.tint;
    }
}

export component StackedBar inherits Rectangle {
    in property <[Segment]> segments;
    height: 14px;
    border-radius: 7px;
    background: Theme.surface-2;
    clip: true;
    // Posição calculada no Rust (offset acumulado), sem layout: evita laço de largura.
    for s in root.segments: Rectangle {
        x: root.width * s.offset;
        y: 0;
        width: max(0px, root.width * s.fraction - 2px);
        height: root.height;
        background: s.color;
    }
}

export component Muted inherits Text {
    color: Theme.text-2;
    font-size: 13px;
    wrap: word-wrap;
}

export component Title inherits Text {
    color: Theme.text;
    font-size: 26px;
    font-weight: 700;
}

export component Section inherits Text {
    color: Theme.text-2;
    font-size: 13px;
    font-weight: 700;
}

export component Banner inherits Rectangle {
    in property <string> text;
    in property <string> action;
    callback clicked();
    background: Theme.warn-bg;
    border-radius: 12px;
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        Icon {
            commands: Icons.warning;
            tint: Theme.warn-text;
        }
        Text {
            text: root.text;
            color: Theme.warn-text;
            font-size: 14px;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.action != "": Btn {
            text: root.action;
            kind: 2;
            clicked => {
                root.clicked();
            }
        }
    }
}

component StepBtn inherits Rectangle {
    in property <string> text;
    callback clicked();
    width: 52px;
    height: Theme.touch;
    border-radius: 12px;
    background: ta.pressed ? Theme.line : Theme.surface-2;
    accessible-role: button;
    accessible-label: root.text;
    Text {
        text: root.text;
        color: Theme.text;
        font-size: 14px;
        font-weight: 600;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Seletor por botões: [−grande][−pequeno] valor [+pequeno][+grande]
export component Stepper inherits HorizontalLayout {
    in property <string> display;
    in property <string> small-label: "5";
    in property <string> big-label: "1h";
    in property <int> small: 5;
    in property <int> big: 60;
    callback step(int);
    spacing: 4px;
    alignment: center;
    StepBtn {
        text: "−" + root.big-label;
        clicked => {
            root.step(-root.big);
        }
    }
    StepBtn {
        text: "−" + root.small-label;
        clicked => {
            root.step(-root.small);
        }
    }
    Text {
        text: root.display;
        min-width: 92px;
        color: Theme.text;
        font-size: 24px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: text;
    }
    StepBtn {
        text: "+" + root.small-label;
        clicked => {
            root.step(root.small);
        }
    }
    StepBtn {
        text: "+" + root.big-label;
        clicked => {
            root.step(root.big);
        }
    }
}

// Botões lado a lado com um selecionado (abas compactas).
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback changed(int);
    height: 44px;
    border-radius: 22px;
    background: Theme.surface-2;
    HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        for o[i] in root.options: Rectangle {
            border-radius: 18px;
            background: i == root.selected ? Theme.surface : transparent;
            accessible-role: tab;
            accessible-label: o;
            Text {
                text: o;
                color: i == root.selected ? Theme.text : Theme.text-2;
                font-size: 14px;
                font-weight: 600;
            }
            TouchArea {
                clicked => {
                    root.selected = i;
                    root.changed(i);
                }
            }
        }
    }
}

export component ToggleRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> checked;
    callback toggled(bool);
    min-height: 56px;
    accessible-role: switch;
    accessible-label: root.text;
    accessible-checked: root.checked;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.text;
                color: Theme.text;
                font-size: 15px;
                wrap: word-wrap;
            }
            if root.detail != "": Muted {
                text: root.detail;
            }
        }
        Rectangle {
            width: 52px;
            height: 32px;
            border-radius: 16px;
            background: root.checked ? Theme.accent : Theme.surface-2;
            border-width: root.checked ? 0 : 2px;
            border-color: Theme.text-2;
            Rectangle {
                width: root.checked ? 24px : 16px;
                height: self.width;
                border-radius: self.width / 2;
                x: root.checked ? parent.width - self.width - 4px : 8px;
                background: root.checked ? Theme.on-accent : Theme.text-2;
                animate x, width { duration: 120ms; }
            }
        }
    }
    TouchArea {
        clicked => {
            root.toggled(!root.checked);
        }
    }
}

// Diálogo centralizado sobre um fundo escurecido. Sobe quando o teclado virtual aparece.
export component Sheet inherits Rectangle {
    in property <string> title;
    in property <length> top-inset;
    in property <length> avail-height: self.height;
    callback dismiss();

    background: Theme.scrim;

    TouchArea {
        clicked => {
            root.dismiss();
        }
    }

    panel := Rectangle {
        property <length> max-h: root.avail-height - root.top-inset - 32px;
        x: 16px;
        width: root.width - 32px;
        height: min(inner.preferred-height, self.max-h);
        y: max(root.top-inset + 16px, (root.avail-height - self.height) / 2);
        background: Theme.surface;
        border-radius: 24px;
        clip: true;

        TouchArea { }

        Flickable {
            inner := VerticalLayout {
                padding: 20px;
                spacing: 14px;
                HorizontalLayout {
                    Text {
                        text: root.title;
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    IconButton {
                        icon: Icons.close;
                        label: "Fechar";
                        clicked => {
                            root.dismiss();
                        }
                    }
                }
                @children
            }
        }
    }
}
