// Primeira execução (RF04, RF14): tempo reservado e início do dia → tags sugeridas → começar.
import { Theme, Icons } from "theme.slint";
import { Api } from "api.slint";
import { Icon, Btn, Card, Muted, Title, Stepper } from "widgets.slint";
import { ReservedList } from "reserved.slint";

export component Onboarding inherits Rectangle {
    in property <length> bottom-inset;
    property <int> step: 0;
    property <int> day-start: 4 * 60;

    background: Theme.bg;

    Flickable {
        VerticalLayout {
            padding: 20px;
            padding-top: 24px;
            padding-bottom: root.bottom-inset + 24px;
            spacing: 16px;
            alignment: start;

            Text {
                text: "Passo " + (root.step + 1) + " de 2";
                color: Theme.accent;
                font-size: 13px;
                font-weight: 700;
            }

            if root.step == 0: VerticalLayout {
                spacing: 16px;
                Title {
                    text: "Quanto tempo você reserva?";
                    wrap: word-wrap;
                }
                Muted {
                    text: "Crie blocos para o tempo que não entra no planejamento: sono, faculdade, deslocamento… O que sobrar das 24h é o seu tempo disponível, dividido depois em porcentagens.";
                    font-size: 15px;
                }
                ReservedList { }
                Text {
                    text: Api.reserved-summary;
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Card {
                    Muted {
                        text: "Meu dia começa às";
                    }
                    Stepper {
                        display: Api.clock-text(root.day-start);
                        small: 15;
                        small-label: "15";
                        step(d) => {
                            root.day-start = Api.wrap-minutes(root.day-start + d);
                        }
                    }
                    Muted {
                        text: "Nesse horário os timers zeram e um novo dia começa.";
                        horizontal-alignment: center;
                    }
                }
                Btn {
                    text: "Continuar";
                    clicked => {
                        root.step = 1;
                    }
                }
            }

            if root.step == 1: VerticalLayout {
                spacing: 16px;
                Title {
                    text: "Como quer dividir?";
                    wrap: word-wrap;
                }
                Muted {
                    text: "Escolha algumas tags para começar. Você ajusta nomes e porcentagens depois, na aba Planejar.";
                    font-size: 15px;
                }
                for s[i] in Api.suggestions: Rectangle {
                    background: Theme.surface;
                    border-radius: Theme.radius;
                    border-width: s.checked ? 2px : 1px;
                    border-color: s.checked ? s.color : Theme.line;
                    accessible-role: checkbox;
                    accessible-label: s.name + ", " + s.percent;
                    accessible-checked: s.checked;
                    HorizontalLayout {
                        padding: 14px;
                        spacing: 12px;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 6px;
                            background: s.checked ? s.color : transparent;
                            border-width: 2px;
                            border-color: s.checked ? s.color : Theme.text-2;
                            if s.checked: Icon {
                                x: 0;
                                y: 0;
                                commands: Icons.check;
                                tint: #FFFFFF;
                            }
                        }
                        Text {
                            text: s.name;
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: s.percent;
                            color: Theme.text-2;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            Api.suggestions[i].checked = !s.checked;
                        }
                    }
                }
                Muted {
                    text: "Para avisar quando o tempo de uma tag acabar, o app vai pedir permissão para enviar notificações.";
                }
                HorizontalLayout {
                    spacing: 12px;
                    Btn {
                        text: "Voltar";
                        kind: 1;
                        clicked => {
                            root.step = 0;
                        }
                    }
                    Btn {
                        text: "Começar";
                        horizontal-stretch: 1;
                        clicked => {
                            Api.finish-onboarding(root.day-start);
                        }
                    }
                }
            }
        }
    }
}
