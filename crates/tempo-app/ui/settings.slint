// Ajustes: sono, timer, permissões e dados (RF01, RF33–RF36).
import { ScrollView, ComboBox } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Api, Dlg } from "api.slint";
import { Btn, Card, Muted, Title, Section, Stepper, ToggleRow } from "widgets.slint";

export component SettingsPage inherits Rectangle {
    background: Theme.bg;

    ScrollView {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;

            Title {
                text: "Ajustes";
            }

            Section {
                text: "DIA";
            }
            Card {
                Muted {
                    text: "Meu dia começa às";
                }
                Stepper {
                    display: Api.clock-text(Api.set-day-start);
                    small: 15;
                    small-label: "15";
                    step(d) => {
                        Api.set-day-start = Api.wrap-minutes(Api.set-day-start + d);
                    }
                }
                Muted {
                    text: "Nesse horário os timers zeram e começa um novo dia no histórico. Quem dorme tarde pode usar a madrugada (ex.: 04:00).";
                    horizontal-alignment: center;
                }
                Btn {
                    text: "Salvar horário";
                    clicked => {
                        Api.save-day-start(Api.set-day-start);
                    }
                }
                Muted {
                    text: "O tempo reservado (sono e outros blocos) fica na aba Planejar.";
                    horizontal-alignment: center;
                }
            }

            Section {
                text: "TIMER";
            }
            Card {
                inner-spacing: 0;
                ToggleRow {
                    text: "Continuar no excedente";
                    detail: "Depois de zerar, o timer segue contando o tempo extra.";
                    checked: Api.overtime;
                    toggled(v) => {
                        Api.set-overtime(v);
                    }
                }
                ToggleRow {
                    text: "Som ao terminar";
                    checked: Api.sound;
                    toggled(v) => {
                        Api.set-sound(v);
                    }
                }
                ToggleRow {
                    text: "Vibrar ao terminar";
                    checked: Api.vibration;
                    toggled(v) => {
                        Api.set-vibration(v);
                    }
                }
            }

            if Api.is-android: Section {
                text: "PERMISSÕES";
            }
            if Api.is-android: Card {
                Text {
                    text: Api.notif-granted ? "Notificações permitidas" : "Notificações bloqueadas";
                    color: Theme.text;
                    font-size: 15px;
                }
                Muted {
                    text: "Usadas para mostrar o timer em andamento e avisar quando o tempo acabar.";
                }
                if !Api.notif-granted: Btn {
                    text: "Permitir notificações";
                    kind: 1;
                    clicked => {
                        Api.request-notifications();
                    }
                }
                Text {
                    text: Api.exact-granted ? "Alarmes exatos permitidos" : "Alarmes exatos bloqueados";
                    color: Theme.text;
                    font-size: 15px;
                }
                Muted {
                    text: "Sem esta permissão, o aviso de fim pode atrasar alguns minutos com o aparelho em repouso.";
                }
                if !Api.exact-granted: Btn {
                    text: "Permitir alarmes exatos";
                    kind: 1;
                    clicked => {
                        Api.request-exact-alarms();
                    }
                }
            }

            Section {
                text: "DADOS";
            }
            Card {
                Muted {
                    text: "Manter histórico";
                }
                ComboBox {
                    model: ["Para sempre", "90 dias", "180 dias", "365 dias"];
                    current-index: Api.retention-index;
                    selected(v) => {
                        Api.set-retention(self.current-index);
                    }
                }
                Btn {
                    text: "Exportar sessões (CSV)";
                    kind: 1;
                    clicked => {
                        Api.export-csv();
                    }
                }
                Btn {
                    text: "Apagar todos os dados";
                    icon: Icons.delete;
                    kind: 3;
                    clicked => {
                        Dlg.confirm-title = "Apagar todos os dados?";
                        Dlg.confirm-text = "Tags, sessões, histórico e ajustes serão apagados. Isso não pode ser desfeito.";
                        Dlg.confirm-button = "Apagar tudo";
                        Dlg.confirm-action = "erase";
                        Dlg.kind = 4;
                    }
                }
            }

            Muted {
                text: "Tempo " + Api.version + " · seus dados ficam só neste aparelho.";
                horizontal-alignment: center;
            }
        }
    }
}
