{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tempo",
  "identifier": "com.projetotempo.tempo",
  "build": {
    "devUrl": "http://127.0.0.1:8080",
    "frontendDist": "../tempo-web/dist",
    "beforeDevCommand": {
      "script": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/dev-web.ps1",
      "wait": false
    },
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-web.ps1"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tempo",
        "width": 1180,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Gestão de tempo por disponibilidade",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    }
  }
}
